{
  "name": "onsite-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --mode web",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build --mode web && vite build --mode legacy && vite build --mode central && tsc -p tsconfig.server.json",
    "start": "node dist-server/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "fastify": "^5.12.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "typescript": "^5.9.3",
    "vite": "^6.0.0",
    "vitest": "^3.2.7"
  }
}
