{
  "name": "onsite-local-se",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "start": "node dist/server.js",
    "db:migrate": "node dist/cli/migrate.js",
    "db:seed": "node dist/cli/seed.js",
    "db:reset": "node dist/cli/reset.js",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "eval:normalization": "npm run build && node dist/cli/eval-normalization.js",
    "llm:smoke": "npm run build && node --env-file=../../.env dist/cli/llm-smoke.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.5.0",
    "@fastify/swagger": "^9.9.3",
    "@fastify/swagger-ui": "^6.1.3",
    "@google/genai": "^2.32.0",
    "@sinclair/typebox": "^0.34.52",
    "fastify": "^5.12.8",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
