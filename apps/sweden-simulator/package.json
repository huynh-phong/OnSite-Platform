{
  "name": "sweden-simulator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "start": "node dist/server.js",
    "db:migrate": "node dist/cli/migrate.js",
    "db:seed": "node dist/cli/seed.js",
    "db:reset": "node dist/cli/reset.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/swagger": "^9.9.3",
    "@fastify/swagger-ui": "^6.1.3",
    "@sinclair/typebox": "^0.34.52",
    "fastify": "^5.12.8",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
