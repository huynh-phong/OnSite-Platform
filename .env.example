# Placeholders only. Run scripts/init-env.sh to create a git-ignored .env with random values.

# --- Local SE ---
COUNTRY_CODE=SE
SE_DB_USER=onsite_se
SE_DB_PASSWORD=REPLACE_ME
SE_DB_NAME=onsite_se
# Used by tests and tools on the host; containers use the se-db service name.
SE_DATABASE_URL=postgres://onsite_se:REPLACE_ME@localhost:5433/onsite_se
SE_JWT_SECRET=REPLACE_ME
# 32 random bytes, base64 encoded.
SE_DATA_KEY=REPLACE_ME
SE_DATA_KEY_ID=se-key-v1
DEMO_PASSWORD=REPLACE_ME
# Empty outbox target means events stay PENDING and Local SE keeps working.
CENTRAL_INGEST_URL=
SE_CENTRAL_TOKEN=REPLACE_ME
# Lets admin.se wipe and re-seed all demo data from the web. Never enable outside a demo.
DEMO_RESET_ENABLED=true
# Circuit breaker: a node silent for longer than this is isolated. The Round 1 design and the code default are
# 300 (5 minutes); the demo shortens it so the effect fits in a recording.
NODE_HEARTBEAT_TIMEOUT_SECONDS=60

# --- Simulator ---
SIM_DB_USER=sweden_sim
SIM_DB_PASSWORD=REPLACE_ME
SIM_DB_NAME=sweden_sim
SIM_DATABASE_URL=postgres://sweden_sim:REPLACE_ME@localhost:5434/sweden_sim
SIMULATOR_BASE_URL=http://sweden-simulator:5000
SIMULATOR_SERVICE_TOKEN=REPLACE_ME

# --- LLM (normalization suggestions only) ---
# mock | anthropic | gemini. Only an unknown product value is ever sent to the provider.
# Gemini reads GEMINI_API_KEY; anthropic reads LLM_API_KEY. LLM_MODEL is optional.
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=
GEMINI_API_KEY=

# --- OnSite Central ---
CENTRAL_DB_USER=onsite_central
CENTRAL_DB_PASSWORD=REPLACE_ME
CENTRAL_DB_NAME=onsite_central
CENTRAL_DATABASE_URL=postgres://onsite_central:REPLACE_ME@localhost:5435/onsite_central
CENTRAL_ADMIN_PASSWORD=REPLACE_ME

# --- Sweden Simulator dashboard ---
SIM_DASHBOARD_PASSWORD=REPLACE_ME
